          }
        }
      }
    },
    "GIP (Xbox) mode: macOS has no driver for this controller, so it is not configured yet. The XPadMac driver will take it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ GIP (Xbox): macOS không có driver cho tay cầm này nên nó chưa được cấu hình. Driver XPadMac sẽ nhận nó."
          }
        }
      }
    },
    "GIP (Xbox) mode: the device is configured but no driver has taken it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
