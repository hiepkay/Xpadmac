            "value" : "Tay cầm không tên"
          }
        }
      }
    },
    "Unplug and replug the controller, then open \"Controllers\": it should be listed as an Xbox Wireless Controller." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rút ra và cắm lại tay cầm, rồi xem mục \"Tay cầm\": tay cầm phải hiện là Xbox Wireless Controller."
