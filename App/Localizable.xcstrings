      }
    },
    "%@: this controller has no such button" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: tay cầm không có nút này"
          }
        }
      }
    },
    "%lld intervals · %lld pauses over %lld ms (left out). Median and p99 use 0.01 ms bins (below 20 ms) and 1 ms bins (above 20 ms)." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld khoảng cách · %2$lld khoảng nghỉ trên %3$lld ms (không tính). Trung vị và p99 lấy theo ô 0,01 ms (dưới 20 ms), 1 ms (trên 20 ms)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@intervals@ · %#@pauses@ over %3$lld ms (left out). Median and p99 use 0.01 ms bins (below 20 ms) and 1 ms bins (above 20 ms)."
          },
          "substitutions" : {
