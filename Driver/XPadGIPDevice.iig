/*
 * XPadGIPDevice: matches an Xbox One / Series (GIP) pad's IOUSBHostDevice
 * and selects its configuration, the job Apple's XboxUSBDevice does for
 * Microsoft's own PIDs. macOS has no driver for a vendor-class (255)
 * device, so without this nobody sets a configuration and the pad's
 * interfaces never appear. Once they do, XPadGIPGamepad matches interface 0.
 *
 * Start declines (kIOReturnUnsupported) a vendor-class device of the same
 * vendor that has no GIP interface (FF/47/D0), leaving it untouched.
 *
 * Personality property XPadWindowsDescriptors (boolean, default false):
 * first ask for the Microsoft OS string descriptor (0xEE) and, when it
 * answers "MSFT100", the extended compat ID, as Windows does.
 *
 * SPDX-License-Identifier: GPL-3.0-or-later
 */
#ifndef XPadGIPDevice_h
#define XPadGIPDevice_h

#include <Availability.h>
#include <DriverKit/IOService.iig>

class IOUSBHostDevice;

class XPadGIPDevice : public IOService
{
public:
    virtual bool init() override;

    virtual void free() override;

    virtual kern_return_t Start(IOService *provider) override;

    virtual kern_return_t Stop(IOService *provider) override;

private:
    /* Finds the GIP interface and sets the configuration (device open). */
    kern_return_t configure(IOUSBHostDevice *device) LOCALONLY;

    /* The optional Windows OS-descriptor probe (device open). */
    void probeWindowsDescriptors(IOUSBHostDevice *device) LOCALONLY;

    /* The personality's XPadWindowsDescriptors. */
    bool windowsDescriptorsEnabled() LOCALONLY;
};

#endif /* XPadGIPDevice_h */
