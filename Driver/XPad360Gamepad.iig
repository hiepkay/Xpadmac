/*
 * XPad360Gamepad: an Xbox 360 wired (XInput) pad's interface 0
 * (FF/5D/01), published as an Xbox Wireless Controller (045E:0B13,
 * Bluetooth LE descriptor): third-party wired 360 pads, and pads with an
 * XInput mode ("Xbox 360 Controller for Windows"). Apple's
 * XboxGamepad.dext drives only Microsoft's own 045E:028E, which this
 * never matches.
 *
 * The messages are Shared/xpad_x360.c; this class moves their bytes, as
 * XPadGIPGamepad does for GIP: two interrupt-IN reads always queued, never
 * cancelled or timed out while the pad is up, and ClearStall only after a
 * transfer that failed (a bounded number of times in a row). Messages for
 * the pad (the LED at start, rumble) go through a FIFO, one OUT transfer
 * in flight at a time, from one buffer the dext allocated itself. A 20 ms
 * timer stops a rumble whose play time ran out and resends a rumble that
 * failed. Input message 0x00
 * becomes report 1; rumble report 3 becomes the 360 rumble message.
 *
 * SPDX-License-Identifier: GPL-3.0-or-later
 */
#ifndef XPad360Gamepad_h
#define XPad360Gamepad_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/OSAction.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>
#include <USBDriverKit/IOUSBHostPipe.iig>
#include <HIDDriverKit/IOUserHIDDevice.iig>

class XPad360Gamepad : public IOUserHIDDevice
{
public:
    virtual bool init() override;

    virtual void free() override;

    virtual kern_return_t Start(IOService *provider) override;

    /* Cancels the timer, aborts the pipes, closes the interface. */
    virtual kern_return_t Stop(IOService *provider) override;

    /* Opens the interface, sets up the pipes, buffers and timer, starts the
     * reads, sends the vendor init request and the LED message. */
    virtual bool handleStart(IOService *provider) override;

    virtual OSDictionary *newDeviceDescription() override;

    virtual OSData *newReportDescriptor() override;

    /* Xbox rumble report 3 -> 360 rumble message. */
    virtual kern_return_t setReport(IOMemoryDescriptor *report,
                                    IOHIDReportType reportType,
                                    IOOptionBits options,
                                    uint32_t completionTimeout,
                                    OSAction *action) override;

    /* Input report 1 from the current state; nothing else exists. */
    virtual kern_return_t getReport(IOMemoryDescriptor *report,
                                    IOHIDReportType reportType,
                                    IOOptionBits options,
                                    uint32_t completionTimeout,
                                    OSAction *action) override;

protected:
    virtual void ReadComplete(OSAction *action TARGET,
                              IOReturn status,
                              uint32_t actualByteCount,
                              uint64_t completionTimestamp) TYPE(IOUSBHostPipe::CompleteAsyncIO);

    virtual void WriteComplete(OSAction *action TARGET,
                               IOReturn status,
                               uint32_t actualByteCount,
                               uint64_t completionTimestamp) TYPE(IOUSBHostPipe::CompleteAsyncIO);

    virtual void TimerFired(OSAction *action TARGET,
                            uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);

private:
    bool openInterface(IOService *provider) LOCALONLY;

    bool createIO() LOCALONLY;

    kern_return_t submitRead(uint32_t index) LOCALONLY;

    /* The vendor GET (C1 01 0100, 20 bytes) Linux and SDL send at start. */
    void sendInitRequest() LOCALONLY;

    /* Queues one message for the OUT endpoint; true if queued. */
    bool sendMessage(const uint8_t *message, uint32_t length) LOCALONLY;

    void startWrite() LOCALONLY;

    void publish(uint64_t timestamp) LOCALONLY;

    void armTimer() LOCALONLY;

    /* Stops the motors when the last rumble report's play time ran out. */
    void expireRumble(long now) LOCALONLY;

    void teardown() LOCALONLY;
};

#endif /* XPad360Gamepad_h */
